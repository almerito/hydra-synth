{
  "name": "hydra-synth",
  "version": "2.0.0",
  "description": "base synth for hydra-editor - GLSL 3.0 ES compatible",
  "type": "module",
  "main": "./dist/hydra-synth.umd.js",
  "module": "./dist/hydra-synth.es.js",
  "exports": {
    ".": {
      "import": "./dist/hydra-synth.es.js",
      "require": "./dist/hydra-synth.umd.js"
    },
    "./src/glsl/glsl-functions.js": {
      "import": "./src/glsl/glsl-functions.js",
      "require": "./src/glsl/glsl-functions.js"
    }
  },
  "unpkg": "./dist/hydra-synth.umd.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:legacy": "browserify ./src/index.js -p esmify --standalone Hydra > dist/hydra-synth.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojack/hydra-synth.git"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "glsl3",
    "regl",
    "graphics",
    "livecoding",
    "synth"
  ],
  "author": "ojack",
  "license": "AGPL",
  "bugs": {
    "url": "https://github.com/ojack/hydra-synth/issues"
  },
  "homepage": "https://github.com/ojack/hydra-synth#readme",
  "dependencies": {
    "meyda": "^5.6.3",
    "raf-loop": "^1.1.3",
    "regl": "^1.3.9"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "esmify": "^2.1.1",
    "vite": "^5.0.0"
  }
}