{
  "name": "hydra-synth",
  "version": "1.4.0",
  "description": "base synth for hydra-editor",
  "type": "module",
  "main": "./dist/hydra-synth-wgsl.umd.js",
  "exports": {
    ".": {
      "import": "./dist/hydra-synth-wgsl.es.js",
      "require": "./dist/hydra-synth-wgsl.umd.js",
      "types": "./src/hydra-synth.js"
    },
    "./src/glsl/glsl-functions.js": {
      "import": "./src/glsl/glsl-functions.js",
      "require": "./src/glsl/glsl-functions.js"
    }
  },
  "unpkg": "./dist/hydra-synth-wgsl.umd.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojack/hydra-synth.git"
  },
  "keywords": [
    "webgl",
    "regl",
    "graphics",
    "livecoding",
    "synth"
  ],
  "author": "ojack",
  "license": "AGPL",
  "bugs": {
    "url": "https://github.com/ojack/hydra-synth/issues"
  },
  "homepage": "https://github.com/ojack/hydra-synth#readme",
  "dependencies": {
    "meyda": "^5.6.3",
    "raf-loop": "^1.1.3",
    "regl": "^1.3.9",
    "web-naga": "^1.0.1"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "budo": "^11.8.4",
    "esmify": "^2.1.1",
    "vite": "^7.3.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}