{
  "name": "hydra-synth",
  "version": "1.4.0",
  "description": "base synth for hydra-editor",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/hydra-synth.js",
      "require": "./dist/hydra-synth.js"
    },
    "./src/glsl/glsl-functions.js": {
      "import": "./src/glsl/glsl-functions.js",
      "require": "./src/glsl/glsl-functions.js"
    }
  },
  "unpkg": "./dist/hydra-synth.js",
  "scripts": {
    "dev-ssl": "budo ./dev/index.js --ssl --open --live --port 8000 --",
    "dev": "budo ./dev/index.js --open --live --port 8000 -- -p esmify",
    "build": "browserify ./src/index.js -p esmify --standalone Hydra > dist/hydra-synth.js",
    "build:esbuild": "esbuild ./src/index.js --bundle --format=iife --global-name=Hydra --define:global=window --outfile=dist/hydra-synth.js",
    "build:esm": "esbuild ./src/index.js --bundle --format=esm --define:global=window --outfile=dist/hydra-synth.esm.js",
    "dev:simple": "npx http-server . -p 8000 -c-1 -o dist/index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojack/hydra-synth.git"
  },
  "keywords": [
    "webgl",
    "regl",
    "graphics",
    "livecoding",
    "synth"
  ],
  "author": "ojack",
  "license": "AGPL",
  "bugs": {
    "url": "https://github.com/ojack/hydra-synth/issues"
  },
  "homepage": "https://github.com/ojack/hydra-synth#readme",
  "dependencies": {
    "meyda": "^5.6.3",
    "raf-loop": "^1.1.3",
    "regl": "^1.3.9"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "budo": "^11.8.4",
    "esbuild": "^0.27.2",
    "esmify": "^0.1.2"
  }
}